node_modules/
.DS_Store
.env
.env*.local

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Written by scripts/version.mjs at the start of every build, so that the
# deployed site can say which commit it is. Generated, not authored — and
# committing it would mean every build dirtied the tree with its own stamp.
/public/version.json

# Wrangler
.wrangler/
.dev.vars

# The source model for public/store/tshirt.glb — 22MB of Sketchfab
# download. The optimised copy that the site actually serves is committed;
# these originals are not, so re-optimising needs the download again.
# Credit and licence live in public/store/tshirt-license.txt.
/3d/

# The store's share cards: scripts/og.mjs makes one per product in prebuild,
# from the committed catalogue, on every build including the deploy's. 130 of
# them is about 25MB, so they are built rather than kept (2026-11-17). The one
# older card already committed stays tracked.
/public/store/og/*.png
