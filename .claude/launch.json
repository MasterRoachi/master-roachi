{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",

      // Attaches to a running dev server rather than starting one, which is
      // why there is no runtimeExecutable here.
      //
      // Stephan keeps `next dev` running on 3000 himself. Next.js 16 permits
      // only one dev server per directory and refuses to start a second for
      // X:\master-roachi, so a config that spawns its own always loses that
      // race — even on a free port, which "autoPort" was tried and does not
      // help with. Taking the port by killing his server would be worse.
      //
      // If nothing is listening on 3000, start it in a terminal first:
      //
      //   npm run dev
      //
      // ...or use the "dev-start" config below, which does that for you.
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "dev-start",

      // The same server, but started rather than attached — for sessions where
      // nothing is listening on 3000 yet and there is no terminal to start one
      // from. Prefer "dev" whenever Stephan already has his own running: two
      // `next dev` processes for one directory is exactly what Next.js 16
      // refuses, and this one would be the one that fails.
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    }
  ]
}
