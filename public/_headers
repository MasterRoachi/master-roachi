# Cloudflare Workers static-asset headers.
#
# Next copies public/ into out/ at build time, so this lands at out/_headers,
# which is the root of the assets directory wrangler.jsonc points at.
#
# Rules are matched top to bottom; the most specific pattern should come first.

# Content-hashed build output — the filename changes whenever the content does,
# so these can never go stale and never need revalidating. Includes the
# self-hosted Cinzel and Manrope woff2 files under _next/static/media/.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else: HTML, RSS, sitemap, robots. These keep their filenames
# across deploys, so they must revalidate or a content change would not appear
# until the cache expired.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
