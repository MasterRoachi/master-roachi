# Cloudflare Workers static-asset headers.
#
# Next copies public/ into out/ at build time, so this lands at out/_headers,
# the root of the assets directory wrangler.jsonc points at.
#
# Rules APPEND rather than override: a path matching two rules receives the
# headers from both, concatenated. So Cache-Control is set in exactly one rule
# here. Setting it in /* as well produced
#   "max-age=0, must-revalidate, max-age=31536000, immutable"
# on hashed assets, where the first directive wins and the intent is lost.

# Content-hashed build output — the filename changes whenever the content does,
# so these can never go stale. Includes the self-hosted Archivo and Reggae One
# woff2 files (app/fonts/, through next/font/local) under _next/static/media/.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else deliberately omits Cache-Control and keeps Cloudflare's
# default of "public, max-age=0, must-revalidate", which is already correct for
# HTML, RSS, the sitemap and robots — those paths are stable across deploys and
# must revalidate or content changes would not appear.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  # A year, and subdomains, but deliberately NOT preload. max-age is reversible
  # by serving max-age=0 and waiting it out; the preload list is not, and this
  # site does not need to be on it.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Nothing here needs a camera, a microphone or a location.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # Everything is first-party and self-hosted: next/font serves the woff2
  # files from _next/static/media, there is no analytics, and no third-party
  # script or frame. Steam and Printful serve the game and product art over
  # https.
  #
  # 'unsafe-inline' on script-src is a floor, not the rule. Next injects inline
  # bootstrap scripts that differ per page, and a static export has no nonce,
  # so this header has to allow them. But scripts/csp.mjs runs after every
  # build and gives each page a <meta> policy listing the SHA-256 of exactly
  # its own inline scripts. A browser enforces both policies, so an injected
  # inline script is refused by the meta even though this header allows it.
  # Take 'unsafe-inline' out of here and every page breaks: this header has no
  # hashes, and the browser would need both to agree. style-src keeps
  # 'unsafe-inline' for real, for the style tags.
  # form-action names PayFast because the checkout is a form posted to it
  # (live and sandbox) — without that the browser refuses the submit.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://www.payfast.co.za https://sandbox.payfast.co.za; frame-ancestors 'self'; upgrade-insecure-requests
