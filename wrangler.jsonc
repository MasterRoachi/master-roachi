{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "master-roachi",
	"compatibility_date": "2026-09-02",
	// `next build` produces a fully static export in out/, and Cloudflare serves
	// those files directly. The Worker below is not a Next.js server — it exists
	// only for /api/vote, which needs shared mutable state that a static file
	// cannot hold. Assets are matched first, so the Worker is never invoked for
	// a page or an image.
	//
	// Declaring both explicitly also stops `wrangler deploy` from guessing.
	// Without this file, wrangler detects "Next.js", assumes a server-rendered
	// app, and silently runs the OpenNext migration — which then fails looking
	// for .next/standalone/, a directory that only exists for non-static builds.
	"main": "worker/index.ts",
	"assets": {
		"directory": "./out/",
		// How the Worker reaches the static files, for anything it does not
		// handle itself.
		"binding": "ASSETS",
		// next.config.mjs sets trailingSlash: true, so pages are emitted as
		// out/work/index.html and served at /work/. auto-trailing-slash is the
		// matching behaviour.
		"html_handling": "auto-trailing-slash",
		// Serve the prerendered app/not-found.tsx page for unmatched routes.
		"not_found_handling": "404-page",
		// The Worker runs before the asset layer.
		//
		// Needed because www.masterroachi.com is a custom domain on this same
		// Worker, and both hostnames were serving the whole site at 200 — the
		// site was reachable at two addresses, which is duplicate content
		// Google can index and split. Assets are matched first by default, so
		// a request to www never reached any code that could redirect it.
		//
		// The cost is that every request now enters the Worker, which hands
		// anything that is not the API or a wrong hostname straight back to
		// ASSETS.fetch.
		"run_worker_first": true
	},
	// Routing lives here rather than in the dashboard, because deploys overwrite
	// the dashboard.
	//
	// `workers_dev` defaults to true, so every deploy was re-enabling
	// master-roachi.sidphanus.workers.dev no matter how many times it was
	// switched off by hand — the site was being served from two hostnames, which
	// is duplicate content Google can index. Same story for preview URLs.
	"workers_dev": false,
	"preview_urls": false,
	// Custom domains. Cloudflare creates the DNS records and issues the
	// certificates for these itself; declaring them here means a deploy restores
	// them if anything drifts, and adds www rather than leaving it unresolvable.
	"routes": [
		{
			"pattern": "masterroachi.com",
			"custom_domain": true
		},
		{
			"pattern": "www.masterroachi.com",
			"custom_domain": true
		}
	],
	// Where the "what should I play next" votes live. A namespace id is an
	// identifier, not a credential, so it belongs in the repo — the Worker still
	// needs the account's own auth to reach it.
	//
	// The voter hash is salted by a VOTE_SALT secret, set separately with
	// `npx wrangler secret put VOTE_SALT` once the Worker is deployed. Without
	// it the hash of a given address is guessable.
	"kv_namespaces": [
		{
			"binding": "VOTES",
			"id": "4015d6eaebb04b8ab4fc9596f87b429e"
		}
	]
}