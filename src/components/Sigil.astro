---
// The site's recurring mark — a diamond/compass sigil. Used small in the
// nav, huge and faint as a watermark behind the hero, tiny on card corners,
// and as the section-divider motif. One shape, reused everywhere, instead
// of a different generic divider/icon per spot.
//
// `variant="full"` adds the crosshair + center dot (nav, watermark, about).
// `variant="mark"` is just the diamond outline (section dividers, card
// corners).
interface Props {
  size?: number;
  color?: string;
  strokeWidth?: number;
  opacity?: number;
  variant?: 'full' | 'mark';
}

const {
  size = 24,
  color = 'currentColor',
  strokeWidth = 1.3,
  opacity = 1,
  variant = 'full',
} = Astro.props;
---

<svg
  viewBox="0 0 28 28"
  width={size}
  height={size}
  fill="none"
  stroke={color}
  stroke-width={strokeWidth}
  style={`opacity:${opacity}`}
  aria-hidden="true"
>
  <path d="M14 2 L24 14 L14 26 L4 14 Z" />
  {variant === 'full' && (
    <>
      <path d="M14 9 L14 19 M9 14 L19 14" />
      <circle cx="14" cy="14" r="1.8" fill={color} stroke="none" />
    </>
  )}
</svg>
