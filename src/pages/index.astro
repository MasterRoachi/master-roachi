---
import Sigil from '../components/Sigil.astro';
import Divider from '../components/Divider.astro';

// One-page site: Hero, Work, About, Contact. See SPEC.md for the decisions
// behind this — content, structure, and visual direction all logged there.
const CONTACT_EMAIL = '[YOUR@EMAIL]'; // TODO before deploy: real address
const GITHUB_URL = '#'; // TODO before deploy: real GitHub profile URL
const LINKEDIN_URL = '#'; // TODO before deploy: real LinkedIn URL
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Master Roachi</title>
    <meta name="description" content="Software engineer. Writes about code, sometimes about theology." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Manrope:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <div class="grain"></div>
    <div class="glow glow--gold-1"></div>
    <div class="glow glow--teal"></div>
    <div class="glow glow--gold-2"></div>

    <div class="page">
      <header class="nav">
        <div class="nav__brand">
          <Sigil size={20} color="var(--gold)" />
          <span class="nav__wordmark">MASTER ROACHI</span>
        </div>
        <nav class="nav__links">
          <a href="#work">WORK</a>
          <a href="#about">ABOUT</a>
          <a href="#contact">CONTACT</a>
        </nav>
      </header>

      <section class="hero">
        <div class="hero__watermark">
          <Sigil size={440} color="var(--gold)" strokeWidth={0.4} opacity={0.06} />
        </div>
        <p class="hero__eyebrow">Software Engineer</p>
        <h1 class="hero__title">Master Roachi</h1>
        <div class="hero__rule">
          <span></span>
          <i></i>
          <span></span>
        </div>
        <p class="hero__tagline">
          Code by trade, worlds by nature. What I build and what I write about, gathered in one place.
        </p>
      </section>

      <Divider />

      <section id="work" class="work">
        <div class="work__intro">
          <p class="eyebrow">Selected Work</p>
          <h2 class="section-title">Things I've Built</h2>
          <p class="section-lede">
            Mostly Odin Project exercises for now. More is coming, in the light hours between everything else.
          </p>
        </div>
        <div class="work__grid">
          <a
            href="https://github.com/MasterRoachi/odin-projects"
            class="card card--live"
          >
            <span class="card__corner">
              <Sigil size={18} color="var(--gold)" variant="mark" opacity={0.7} />
            </span>
            <p class="card__label card__label--gold">The Odin Project</p>
            <p class="card__title">Everything I've Built So Far</p>
            <p class="card__body">
              Eight exercises, HTML/CSS basics through DOM manipulation — admin dashboards, drawing grids,
              a themed Rock-Paper-Scissors game, and more. Browse the full collection on GitHub.
            </p>
          </a>
          <div class="card card--soon">
            <span class="card__corner">
              <Sigil size={18} color="var(--teal)" variant="mark" opacity={0.6} />
            </span>
            <p class="card__label card__label--teal">Coming Soon</p>
            <p class="card__title card__title--muted">Shepherds We Shall Be</p>
            <p class="card__body card__body--muted">
              A 2.5D pixel art ARPG, built solo in Godot. Still early — details land here once there's
              something worth showing.
            </p>
          </div>
        </div>
      </section>

      <Divider />

      <section id="about" class="about">
        <div class="about__mark">
          <Sigil size={150} color="var(--gold)" strokeWidth={0.8} opacity={0.4} />
        </div>
        <div class="about__copy">
          <p class="eyebrow">About</p>
          <p class="about__bio">
            My name is Stephan Engelbrecht. I go by Master Roachi. I'm a software engineer, and outside of
            that I write — mostly about code, sometimes about theology.
          </p>
        </div>
      </section>

      <section id="contact" class="contact">
        <h2 class="contact__title">Get In Touch</h2>
        <p class="contact__lede">Open to tutoring inquiries, collaboration, or just a good argument.</p>
        <a class="contact__email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        <div class="contact__socials">
          <a href={GITHUB_URL}>GitHub</a>
          <a href={LINKEDIN_URL}>LinkedIn</a>
        </div>
      </section>

      <footer class="footer">© {new Date().getFullYear()} Master Roachi</footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: oklch(16% 0.015 260);
    --ink: oklch(92% 0.01 90);
    --muted: oklch(65% 0.02 260);
    --muted-2: oklch(55% 0.02 260);
    --line: oklch(30% 0.02 260 / 0.6);
    --gold: oklch(75% 0.13 85);
    --teal: oklch(75% 0.13 220);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Manrope', system-ui, sans-serif;
    position: relative;
    overflow-x: hidden;
  }

  a {
    color: var(--gold);
    text-decoration: none;
  }

  a:hover {
    color: oklch(85% 0.13 85);
  }
</style>

<style>
  .grain {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background-image: radial-gradient(circle, oklch(100% 0 0 / 0.035) 1px, transparent 1px);
    background-size: 3px 3px;
  }

  .glow {
    position: absolute;
    pointer-events: none;
    z-index: 0;
    border-radius: 50%;
  }
  .glow--gold-1 {
    top: -100px;
    left: -200px;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, oklch(28% 0.04 85 / 0.28), transparent 65%);
  }
  .glow--teal {
    top: 900px;
    right: -250px;
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, oklch(26% 0.05 220 / 0.22), transparent 65%);
  }
  .glow--gold-2 {
    top: 1750px;
    left: -150px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, oklch(28% 0.04 85 / 0.16), transparent 65%);
  }

  .page {
    position: relative;
    z-index: 2;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 72px;
    border-bottom: 1px solid var(--line);
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .nav__wordmark {
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: 19px;
    letter-spacing: 0.08em;
  }
  .nav__links {
    display: flex;
    gap: 36px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.03em;
  }
  .nav__links a {
    color: oklch(80% 0.01 90);
  }
  .nav__links a:hover {
    color: var(--gold);
  }

  .hero {
    position: relative;
    padding: 130px 72px 80px;
    text-align: center;
  }
  .hero__watermark {
    position: absolute;
    top: 40px;
    left: 50%;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .hero__eyebrow {
    position: relative;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 28px;
  }
  .hero__title {
    position: relative;
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: 72px;
    line-height: 1.12;
    margin: 0 0 24px;
  }
  .hero__rule {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin: 0 auto 32px;
  }
  .hero__rule span {
    width: 60px;
    height: 1px;
    background: oklch(45% 0.02 260);
  }
  .hero__rule i {
    width: 7px;
    height: 7px;
    background: var(--gold);
    transform: rotate(45deg);
  }
  .hero__tagline {
    position: relative;
    font-size: 18px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 560px;
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 16px;
  }
  .section-title {
    font-family: 'Cinzel', serif;
    font-weight: 600;
    font-size: 32px;
    margin: 0 0 14px;
  }
  .section-lede {
    font-size: 16px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 480px;
    margin: 0 auto;
  }

  .work {
    padding: 20px 72px 100px;
  }
  .work__intro {
    max-width: 900px;
    margin: 0 auto 48px;
    text-align: center;
  }
  .work__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 32px;
    max-width: 920px;
    margin: 0 auto;
  }
  @media (max-width: 760px) {
    .work__grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    position: relative;
    display: block;
    padding: 36px;
    padding-top: 44px;
    color: var(--ink);
    transition: border-color 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
  }
  .card--live {
    background: oklch(14% 0.015 260);
    border: 1px solid oklch(75% 0.13 85 / 0.35);
    transform: rotate(-1.2deg) translateY(6px);
    box-shadow: 0 12px 28px oklch(0% 0 0 / 0.25);
  }
  .card--live:hover {
    border-color: var(--gold);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px oklch(0% 0 0 / 0.35);
  }
  .card--soon {
    background: oklch(13% 0.015 260 / 0.7);
    border: 1px dashed oklch(75% 0.13 220 / 0.4);
    transform: rotate(1deg) translateY(-6px);
  }
  .card--soon:hover {
    border-color: oklch(75% 0.13 220 / 0.6);
    transform: translateY(-4px);
  }
  .card__corner {
    position: absolute;
    top: 20px;
    right: 20px;
  }
  .card__label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    margin: 0 0 14px;
  }
  .card__label--gold {
    color: var(--gold);
  }
  .card__label--teal {
    color: var(--teal);
  }
  .card__title {
    font-family: 'Cinzel', serif;
    font-size: 20px;
    margin: 0 0 12px;
  }
  .card__title--muted {
    color: oklch(80% 0.02 260);
  }
  .card__body {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }
  .card__body--muted {
    color: var(--muted-2);
  }

  .about {
    padding: 100px 72px;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    max-width: 920px;
    margin: 0 auto;
    align-items: center;
  }
  .about__mark {
    display: flex;
    justify-content: center;
  }
  .about__bio {
    font-family: 'Cinzel', serif;
    font-weight: 500;
    font-size: 26px;
    line-height: 1.65;
    margin: 0;
  }
  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }

  .contact {
    padding: 90px 72px 70px;
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .contact__title {
    font-family: 'Cinzel', serif;
    font-weight: 600;
    font-size: 22px;
    margin: 0 0 12px;
    letter-spacing: 0.03em;
  }
  .contact__lede {
    font-size: 15px;
    color: var(--muted);
    margin: 0 0 24px;
  }
  .contact__email {
    border: 1px solid var(--gold);
    padding: 12px 26px;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.03em;
    display: inline-block;
    margin-bottom: 24px;
  }
  .contact__socials {
    display: flex;
    gap: 28px;
    justify-content: center;
    font-size: 14px;
  }
  .contact__socials a {
    color: oklch(75% 0.02 260);
  }
  .contact__socials a:hover {
    color: var(--gold);
  }

  .footer {
    padding: 26px 72px;
    border-top: 1px solid var(--line);
    text-align: center;
    font-size: 13px;
    color: var(--muted-2);
  }
</style>
